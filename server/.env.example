NODE_ENV=development
CLIENT_ID=domain_demo
DOMAIN=domain.com
# emailDomain:registeredDomain pairs, e.g. tr3.io:trade3.io
EMAIL_DOMAIN_ALIASES=
ADMIN_WALLET=0xadmin
PORT=8080
HOST=0.0.0.0
ADMIN_API_KEY=replace-with-a-long-random-admin-key
APP_API_KEY=replace-with-a-long-random-app-key
OTP_TTL_MS=300000
GOOGLE_CHAT_WEBHOOK_URL=
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PRIVATE_KEY=
SUI_PACKAGE_ID=0xd06ff3a35bb182b5e4577440d71470373fc4c36315c27dca90c8af3e8d9367b6
SUI_MODULE=photo_attestation
SUI_REGISTRY_ID=0xe8a73abe8d822ad0b9441bd0df47510251c8b2c9d84f1d6ffcaa340bf2daea4e
SUI_GAS_BUDGET=10000000
# Domain-sponsored attestation gas. The sponsor wallet must be a dedicated
# wallet, never ADMIN_WALLET; fund its address balance, not coin objects.
SPONSOR_ENABLED=false
SPONSOR_PRIVATE_KEY=
SPONSOR_WALLET=
SPONSOR_MAX_GAS_BUDGET_MIST=50000000
SPONSOR_MAX_GAS_PRICE_MIST=1000
SPONSOR_TX_PER_USER_PER_DAY=200
SPONSOR_GAS_PER_USER_PER_DAY_MIST=1000000000
SPONSOR_TX_PER_DOMAIN_PER_DAY=5000
SPONSOR_GAS_PER_DOMAIN_PER_DAY_MIST=50000000000
SPONSOR_PREPARE_TTL_MS=300000
SPONSOR_MIN_BALANCE_MIST=1000000000
SPONSOR_LEAK_CHECK_INTERVAL_MS=900000
VAULT_ENABLED=false
VAULT_ADDR=
VAULT_TOKEN=dev-root-token
VAULT_NAMESPACE=
VAULT_AUTH_METHOD=token
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_KV_MOUNT=secret
VAULT_SECRET_PREFIX=
VAULT_HOST_PORT=8200
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=7776
API_HOST_PORT=8080
