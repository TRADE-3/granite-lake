#!/bin/sh
# Pre-push hook: block pushes with failing builds, tests, lint, or formatting.

set -e

printf "Running pre-push checks...\n"

printf "\n[server] Check\n"
npm run check:server

printf "\n[app] Check\n"
npm run check:app

printf "\n[server] Build\n"
npm run build:server

printf "\n[server] Test\n"
npm run test:server

printf "\n[verification_api] Build\n"
npm --prefix verification_api run build

printf "\n[verification_portal] Build\n"
npm --prefix verification_portal run build

printf "\nPre-push checks passed.\n"
